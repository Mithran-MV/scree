# Copy to .env.local and fill in. .env.local is git-ignored.

# ── The Graph ────────────────────────────────────────────────
# Subgraph Studio API key. Server-side only; never exposed to the browser.
GRAPH_API_KEY=

# ── Testnet burner ───────────────────────────────────────────
# Generated by `node scripts/new-burner.mjs`. Testnet only, never real value.
BURNER_PRIVATE_KEY=
BURNER_ADDRESS=

# ── Hedera: the paid survey ────────────────────────────────────────
# The service account that receives payment and signs receipts. ECDSA key; an
# ED25519 key has no EVM alias. The faucet at portal.hedera.com creates and funds
# a testnet account from an EVM address.
HEDERA_NETWORK=hedera:testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# The agent that pays: the burner above, as a Hedera account (same key).
AGENT_HEDERA_ACCOUNT_ID=
# Where receipts go: one HCS message per settled survey. `npm run hedera:topic` creates it.
HCS_RECEIPTS_TOPIC=
# Price schedule in tinybar (10^-8 HBAR): base per survey, plus per deployment asked.
SURVEY_BASE_TINYBAR=1000000
SURVEY_PER_SOURCE_TINYBAR=500000
# The facilitator is pinned to Blocky402 by network unless overridden here.
# X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# The public origin, used in the manifest and the x402 resource URL.
PUBLIC_URL=http://localhost:3000
