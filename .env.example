# Copy to .env.local and fill in. .env.local is git-ignored.

# ── The Graph ────────────────────────────────────────────────
# Subgraph Studio API key. Server-side only; never exposed to the browser.
GRAPH_API_KEY=

# ── Testnet burner ───────────────────────────────────────────
# Generated by `node scripts/new-burner.mjs`. Testnet only, never real value.
BURNER_PRIVATE_KEY=
BURNER_ADDRESS=

# ── Hedera ───────────────────────────────────────────────────
# Portal testnet account. The key type must be ECDSA: ED25519 keys have no EVM alias.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Pin the facilitator explicitly. The reference implementation defaults testnet to a
# generic facilitator, which silently fails the settlement requirement.
X402_TESTNET_FACILITATOR_URL=https://api.testnet.blocky402.com
